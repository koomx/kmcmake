#include <@CHANGEME@/assets/hello.txt.xxd.h>
#include <@CHANGEME@/xxd_gen.h>

#include <cstdlib>
#include <iostream>
#include <string_view>

int main() {
    using namespace @CHANGEME@;

    // Accept LF or CRLF: Windows checkouts may convert text assets unless
    // .gitattributes marks them -text / eol=lf.
    constexpr std::string_view expected_lf = "hello xxd\n";
    constexpr std::string_view expected_crlf = "hello xxd\r\n";
    if (assets_hello_txt != expected_lf && assets_hello_txt != expected_crlf) {
        std::cerr << "asset content mismatch (size=" << assets_hello_txt.size() << ")\n";
        return EXIT_FAILURE;
    }

    const auto files = xxd_gen_files();
    if (files.size() != 1) {
        std::cerr << "xxd_gen_files size mismatch\n";
        return EXIT_FAILURE;
    }
    if (files[0].first != "assets/hello.txt" ||
        (files[0].second != expected_lf && files[0].second != expected_crlf)) {
        std::cerr << "xxd_gen_files entry mismatch\n";
        return EXIT_FAILURE;
    }

    std::cout << "Passed\n";
    return EXIT_SUCCESS;
}
